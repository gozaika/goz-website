{
  "expo": {
    "name": "goZaika Partner",
    "slug": "gozaika-restaurant",
    "scheme": "gozaika-restaurant",
    "version": "0.1.0",
    "orientation": "default",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.gozaika.restaurant"
    },
    "android": {
      "package": "in.gozaika.restaurant",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F0"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {}
    }
  }
}
